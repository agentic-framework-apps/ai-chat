---
import Chat from '../components/Chat.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Free edge AI chat. Private, persistent threads, zero cost." />
    <title>ShortChat — free AI chat</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <main>
      <h1>ShortChat</h1>
      <p class="tagline">Free AI chat, streamed from the edge.</p>
      <Chat />
    </main>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    background: radial-gradient(1200px 600px at 50% -10%, #0b2740 0%, #0b1220 55%);
    color: #e2e8f0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }
  main {
    width: min(94vw, 680px);
    padding: 1.5rem;
  }
  h1 {
    margin: 0 0 0.25rem;
    font-size: 2.2rem;
    letter-spacing: -0.02em;
  }
  .tagline {
    margin: 0 0 1rem;
    color: #94a3b8;
  }
</style>
